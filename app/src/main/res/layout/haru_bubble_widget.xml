<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/haru_bubble_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <LinearLayout
        android:id="@+id/haru_bubble_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/haru_bubble_background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <TextView
            android:id="@+id/haru_bubble_face"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:minWidth="48dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="₍^. .^₎⟆"
            android:textColor="#241C2B"
            android:textSize="24sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeStepGranularity="1sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/haru_bubble_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:text="Good morning"
            android:textColor="#241C2B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/haru_bubble_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="Ready when you are."
            android:textColor="#675E6D"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/haru_bubble_paused"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/haru_bubble_background"
        android:gravity="center"
        android:padding="6dp"
        android:text="HARU paused · tap to open"
        android:textColor="#675E6D"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
