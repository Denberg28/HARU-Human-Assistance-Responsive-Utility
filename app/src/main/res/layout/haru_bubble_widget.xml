<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/haru_bubble_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="3dp">

    <LinearLayout
        android:id="@+id/haru_bubble_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/haru_bubble_background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/haru_bubble_greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Good morning"
                android:textColor="#2E2337"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/haru_bubble_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Just checking in on you."
                android:textColor="#64556F"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/haru_bubble_face"
            android:layout_width="112dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:maxLines="1"
            android:text="₍^. .^₎⟆"
            android:textColor="#453752"
            android:textSize="25sp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="25sp"
            android:autoSizeStepGranularity="1sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/haru_bubble_paused"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/haru_bubble_background"
        android:gravity="center"
        android:padding="8dp"
        android:text="HARU paused"
        android:textColor="#64556F"
        android:textSize="12sp"
        android:visibility="gone" />
</FrameLayout>
